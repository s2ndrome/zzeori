{
  "manifest_version": 3,
  "name": "케이브덕 한글 스킨",
  "version": "1.0.0",
  "description": "케이브덕 채팅 화면을 한글(HWP) 문서 편집 창처럼 보이게 바꿉니다.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "한글 스킨 설정",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://caveduck.io/*", "https://www.caveduck.io/*"],
      "js": ["content.js"],
      "css": ["theme.css"],
      "run_at": "document_start"
    }
  ]
}
